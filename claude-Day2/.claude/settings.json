{
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest discover -s tests -v)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_edit_check.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
